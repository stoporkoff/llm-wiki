{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Completed sessions",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "sum(factory_sessions_total{state=\"completed\"})", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Agent latency p95",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(factory_agent_duration_milliseconds_bucket[5m])))",
        "legendFormat": "{{agent}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "OpenAI tokens by agent and type",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "sum by (agent, type) (rate(factory_openai_tokens_total[5m]))",
        "legendFormat": "{{agent}} / {{type}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Tool calls",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "expr": "sum by (agent) (rate(factory_tool_calls_total[5m]))",
        "legendFormat": "{{agent}}",
        "refId": "A"
      }]
    }
  ],
